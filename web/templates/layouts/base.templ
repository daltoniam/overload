package layouts

type PageData struct {
	Title string
	CurrentPath string
}

templ Base(data PageData) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyRestoreAsHxRequest":false,"historyCacheSize":0,"reportValidityOfForms":true}'/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/ui.js" defer></script>
			<title>{ data.Title } · overload</title>
			<script>try { var theme = localStorage.getItem('overload-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch (_) {}</script>
			<style>
				:root { color-scheme: light; --ink: #172635; --muted: #627282; --line: #dce4e9; --surface: #fff; --canvas: #f5f7f8; --accent: #176b66; --soft: #e6f3ef; --field: #fff; --field-line: #cbd6dd; --subtle: #f7f9fa; --badge: #eef1f4; --badge-ink: #506070; --code: #eef3f5; --placeholder: #87949f; --hover: #12534f; --button-ink: #fff; --danger: #b42334; --danger-hover: #891728; }
				@media (prefers-color-scheme: dark) { :root:not([data-theme]) { color-scheme: dark; --ink: #e6edf2; --muted: #b1c1cd; --line: #384958; --surface: #1c2a35; --canvas: #111c26; --accent: #78d5c0; --soft: #213d3d; --field: #243440; --field-line: #5a7080; --subtle: #20303b; --badge: #304451; --badge-ink: #d0dee6; --code: #304451; --placeholder: #a2b4c0; --hover: #2e8075; --button-ink: #10251f; --danger: #f18491; --danger-hover: #cc5363; } }
				:root[data-theme="light"] { color-scheme: light; --ink: #172635; --muted: #627282; --line: #dce4e9; --surface: #fff; --canvas: #f5f7f8; --accent: #176b66; --soft: #e6f3ef; --field: #fff; --field-line: #cbd6dd; --subtle: #f7f9fa; --badge: #eef1f4; --badge-ink: #506070; --code: #eef3f5; --placeholder: #87949f; --hover: #12534f; --button-ink: #fff; --danger: #b42334; --danger-hover: #891728; }
				:root[data-theme="dark"] { color-scheme: dark; --ink: #e6edf2; --muted: #b1c1cd; --line: #384958; --surface: #1c2a35; --canvas: #111c26; --accent: #78d5c0; --soft: #213d3d; --field: #243440; --field-line: #5a7080; --subtle: #20303b; --badge: #304451; --badge-ink: #d0dee6; --code: #304451; --placeholder: #a2b4c0; --hover: #2e8075; --button-ink: #10251f; --danger: #f18491; --danger-hover: #cc5363; }
				* { box-sizing: border-box; }
				body { margin: 0; background: var(--canvas); color: var(--ink); font: 15px/1.55 system-ui, -apple-system, sans-serif; }
				a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }
				.shell { width: 100%; max-width: 1160px; margin: 0 auto; padding: 0 28px; }
				.app-shell { display: grid; grid-template-columns: 238px minmax(0, 1fr); min-height: 100vh; }
				.sidebar { background: var(--surface); border-right: 1px solid var(--line); padding: 28px 18px; display: flex; flex-direction: column; gap: 24px; min-width: 0; }
				.sidebar .brand { padding: 0 10px; }
				.sidebar-details { display: contents; }
				.sidebar-details summary { display: none; }
				.sidebar-footer { margin-top: auto; padding: 0 10px; }
				.content { min-width: 0; }
				.brand { color: var(--ink); font-weight: 760; letter-spacing: -.045em; font-size: 23px; display: inline-flex; align-items: center; gap: 11px; white-space: nowrap; }
				.brand:hover { text-decoration: none; }
				.brand-mark { width: 28px; height: 28px; background: var(--accent); border-radius: 8px; color: var(--canvas); display: grid; place-items: center; font-size: 17px; font-weight: 650; letter-spacing: 0; }
				nav { display: flex; flex-direction: column; align-items: stretch; gap: 3px; }
				nav a { color: var(--muted); border-radius: 7px; padding: 9px 12px; font-size: 14px; font-weight: 580; } .theme-toggle { white-space: nowrap; padding: 6px 9px; }
				nav a:hover { background: var(--canvas); text-decoration: none; color: var(--ink); }
				nav a[aria-current="page"] { background: var(--soft); color: var(--accent); }
				main { padding-top: 42px !important; padding-bottom: 90px !important; }
				.page-header { display: flex; justify-content: space-between; gap: 20px; align-items: flex-end; margin-bottom: 27px; }
				.eyebrow { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .11em; font-size: 11px; font-weight: 750; color: var(--accent); }
				h1 { font-size: clamp(27px, 3vw, 35px); letter-spacing: -.045em; line-height: 1.16; margin: 0 0 8px; }
				h2 { font-size: 20px; letter-spacing: -.025em; margin: 0 0 5px; }
				h3 { font-size: 16px; margin: 0 0 8px; }
				p { margin: 0 0 16px; } .muted { color: var(--muted); }
				.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 2px 9px #1e344009; padding: 25px; margin-bottom: 18px; min-width: 0; }
				.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 19px; }
				.panel-head p { margin: 0; }
				.kicker { font-size: 12px; font-weight: 720; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin-bottom: 10px; }
				.badge { display: inline-block; padding: 3px 9px; border-radius: 999px; color: var(--accent); background: var(--soft); font-size: 12px; font-weight: 700; white-space: nowrap; }
				.badge.neutral { background: var(--badge); color: var(--badge-ink); }
				.grid { display: grid; grid-template-columns: minmax(0,1.45fr) minmax(310px,1fr); gap: 20px; align-items: start; }
				.stack { display: grid; gap: 16px; min-width: 0; }
				.field { display: block; margin-bottom: 16px; } .field > span { display: block; font-weight: 650; font-size: 13px; margin-bottom: 6px; }
				.field small { display: block; color: var(--muted); margin-top: 5px; }
				input:not([type="checkbox"]), select, textarea { font: inherit; width: 100%; border: 1px solid var(--field-line); border-radius: 8px; padding: 10px 11px; background: var(--field); color: var(--ink); outline-color: var(--accent); }
				textarea { min-height: 92px; resize: vertical; } input::placeholder, textarea::placeholder { color: var(--placeholder); }
				.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
				.check { display: flex; gap: 9px; align-items: center; margin-bottom: 17px; font-size: 14px; }
				button, .button { font: inherit; display: inline-block; cursor: pointer; border-radius: 8px; border: 1px solid var(--accent); padding: 10px 15px; background: var(--accent); color: var(--button-ink); font-weight: 650; font-size: 13px; }
				button:hover, .button:hover { background: var(--hover); text-decoration: none; color: var(--button-ink); }
				button.secondary { background: var(--surface); color: var(--accent); }
				button.secondary:hover { background: var(--soft); }
				button.danger { border-color: var(--danger); background: var(--danger); color: var(--canvas); }
				button.danger:hover { border-color: var(--danger-hover); background: var(--danger-hover); color: var(--canvas); }
				button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
				code { background: var(--code); padding: 2px 5px; border-radius: 4px; font-size: 12px; overflow-wrap: anywhere; }
				pre { background: #172635; color: #dcebe9; border-radius: 9px; padding: 14px 16px; overflow-x: auto; font-size: 12px; line-height: 1.6; }
				pre code { background: none; color: inherit; padding: 0; }
				table { width: 100%; border-collapse: collapse; } th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--line); vertical-align: top; } th { color: var(--muted); font-size: 12px; font-weight: 700; } tbody tr:last-child td { border-bottom: 0; }
				.table-wrap { overflow-x: auto; } .empty { padding: 27px 16px; background: var(--subtle); border: 1px dashed var(--line); border-radius: 8px; color: var(--muted); }
				.profile { border: 1px solid var(--line); border-radius: 9px; padding: 16px; margin-bottom: 10px; }
				.profile:last-child { margin-bottom: 0; } .profile-top { display: flex; align-items: center; gap: 8px; justify-content: space-between; }
				.profile p { color: var(--muted); font-size: 13px; margin: 6px 0 0; overflow-wrap: anywhere; }
				.profile .subline { font-size: 12px; margin-top: 10px; }
				.agent-entry { border: 1px solid var(--line); border-radius: 8px; padding: 13px 14px; background: var(--subtle); margin-bottom: 9px; }
				.agent-entry summary { font-weight: 650; cursor: pointer; }
				.agent-entry .field { margin-top: 14px; } .agent-entry .field:last-child { margin-bottom: 0; }
				.notice { border-left: 3px solid var(--accent); padding: 12px 15px; background: var(--soft); border-radius: 0 8px 8px 0; font-size: 13px; }
				dl { display: grid; grid-template-columns: 135px 1fr; gap: 9px; } dt { color: var(--muted); } dd { margin: 0; overflow-wrap: anywhere; }
				@media (max-width: 780px) { .app-shell { grid-template-columns: 1fr; } .sidebar { border-right: 0; border-bottom: 1px solid var(--line); padding: 14px 18px; gap: 9px; } .sidebar .brand { padding: 0; } .sidebar-details { display: block; } .sidebar-details summary { display: list-item; cursor: pointer; color: var(--accent); font-weight: 650; } .sidebar-details:not([open]) nav { display: none; } nav { padding-top: 8px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); } .sidebar-footer { margin-top: 0; padding: 0; } .grid { grid-template-columns: 1fr; } main { padding-top: 27px !important; } .page-header { align-items: flex-start; flex-direction: column; } }
				@media (max-width: 480px) { .shell { padding-left: 16px; padding-right: 16px; } .panel { padding: 18px; } .field-row { grid-template-columns: 1fr; gap: 0; } }
			</style>
			<link rel="stylesheet" href="/assets/ui.css"/>
		</head>
		<body hx-history="false">
			<a class="skip-link" href="#page-content">Skip to content</a>
			<div class="app-shell"><aside class="sidebar"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">o</span> overload</a><details class="sidebar-details" open><summary>Navigation</summary><nav aria-label="Main navigation">
				@NavigationLink("/", "Overview", data.CurrentPath)
				@NavigationLink("/runs", "Runs", data.CurrentPath)
				@NavigationLink("/settings", "Models", data.CurrentPath)
				@NavigationLink("/configure/agents", "Agents", data.CurrentPath)
				@NavigationLink("/configure/repositories", "Repositories", data.CurrentPath)
				@NavigationLink("/configure/workflows", "Workflows", data.CurrentPath)
				@NavigationLink("/configure/schedules", "Schedules", data.CurrentPath)
				@NavigationLink("/configure/tools", "Tools", data.CurrentPath)
				@NavigationLink("/setup/github", "GitHub", data.CurrentPath)
				@NavigationLink("/webhooks", "Webhooks", data.CurrentPath)
			</nav></details><div class="sidebar-footer"><label class="theme-control"><span>Appearance</span><select id="theme-select" aria-label="Color theme"><option value="auto">System</option><option value="light">Light</option><option value="dark">Dark</option></select></label></div></aside>
			<div class="content"><main class="shell" id="page-content" tabindex="-1"><p id="ui-status" class="notice error" role="status" hidden></p><div id="form-errors" tabindex="-1" role="alert"></div>{ children... }</main></div></div>
			<div id="modal-root"></div>
		</body>
	</html>
}
