package pages

import (
	"fmt"
	"github.com/daltoniam/overload"
	"github.com/daltoniam/overload/web/templates/layouts"
	"strings"
)

func agentStatus(enabled bool) string {
	if enabled {
		return "Enabled"
	}
	return "Disabled"
}

func agentKindValue(kind string) string {
	if kind == "" {
		return "pr_review"
	}
	return kind
}

func agentKindLabel(kind string) string {
	if kind == "scheduled_prompt" {
		return "Scheduled prompt"
	}
	return "PR review"
}

func agentFormTitle(name string) string {
	if name == "" {
		return "New agent"
	}
	return "Edit agent"
}

func repositoryFormTitle(repo overload.Repository) string {
	if repo.ID == 0 {
		return "New repository"
	}
	return repo.FullName
}

func bindingAction(enabled bool) string {
	if enabled {
		return "Disable"
	}
	return "Enable"
}

func repositoryBindings(bindings []overload.TriggerBinding, name string) []overload.TriggerBinding {
	var result []overload.TriggerBinding
	for _, binding := range bindings {
		if binding.Repository == name {
			result = append(result, binding)
		}
	}
	return result
}

templ Agents(agents []overload.AgentDefinition) {
	@layouts.Base(layouts.PageData{Title: "Agents", CurrentPath: "/configure/agents"}) {
		<div class="page-header"><div><p class="eyebrow">Automation / Agents</p><h1>Agents</h1><p class="muted">Each agent is a model and its instructions. Give each focus area its own agent and combine them in a workflow. Editing an agent affects future runs only.</p></div><a class="button" href="/configure/agents/new">New agent</a></div>
		<section class="panel">
			if len(agents) == 0 {
				<div class="empty">No agents yet. <a href="/configure/agents/new">Create an agent</a> after adding a model connection.</div>
			} else {
				<div class="table-wrap"><table class="agents-table"><thead><tr><th>Agent</th><th>Model</th><th>Instructions</th><th>Status</th><th><span class="sr-only">Actions</span></th></tr></thead><tbody>
					for _, agent := range agents {
						<tr data-kind={ agentKindValue(agent.Kind) } data-status={ agentStatus(agent.Enabled) }><td class="nowrap"><strong>{ agent.Name }</strong><span class="secondary-line">{ agentKindLabel(agent.Kind) }</span></td><td class="nowrap">{ agent.Model }</td><td class="prompt-cell"><span class="prompt-excerpt">{ promptExcerpt(agent.Prompt) }</span><span class="secondary-line">Version { fmt.Sprint(agent.PromptRevision) }</span></td><td class="nowrap"><span class={ "badge " + strings.ToLower(agentStatus(agent.Enabled)) }>{ agentStatus(agent.Enabled) }</span></td><td class="nowrap"><a href={ templ.URL("/configure/agents/" + agent.Name) }>View / edit</a></td></tr>
					}
				</tbody></table></div>
			}
		</section>
	}
}

templ AgentForm(agent overload.AgentDefinition, models []overload.ReviewSettings, starters []StarterPrompt, nonce string) {
	@layouts.Base(layouts.PageData{Title: "Agent", CurrentPath: "/configure/agents"}) {
		<div class="page-header"><div><p class="eyebrow"><a href="/configure">Configure</a> / <a href="/configure/agents">Agents</a></p><h1>{ agentFormTitle(agent.Name) }</h1><p class="muted">An agent is a model and its instructions. For several focus areas, create one agent per area and add them to a workflow as sub-agents. Changes apply to future runs; runs already queued keep the instructions they started with.</p></div><a href="/configure/agents">All agents</a></div>
		<section class="panel"><form method="post" action="/configure/agents"><input type="hidden" name="csrf" value={ nonce }/>
			if agent.Name != "" {
				<input type="hidden" name="existing" value={ agent.Name }/>
				<input type="hidden" name="prompt_revision" value={ fmt.Sprint(agent.PromptRevision) }/>
			}
			<label class="field"><span>Name</span><input name="name" required maxlength="64" pattern="[a-zA-Z0-9][a-zA-Z0-9_-]*" value={ agent.Name } readonly?={ agent.Name != "" } placeholder="security-reviewer"/></label>
			<label class="field"><span>Job type</span><select name="kind"><option value="pr_review" selected?={ agent.Kind == "" || agent.Kind == "pr_review" }>Pull request review</option><option value="scheduled_prompt" selected?={ agent.Kind == "scheduled_prompt" }>Scheduled prompt</option></select><small>Choose the type of workflow this agent can join. A workflow uses the agent as its main agent or a sub-agent.</small></label>
			<label class="field"><span>Model connection</span><select name="model" required><option value="">Select a model</option>
				for _, model := range models {
					<option value={ model.Name } selected?={ model.Name == agent.Model }>{ model.Name } ({ model.Model })</option>
				}
			</select><small><a href="/settings">Manage model connections</a></small></label>
			<label class="field"><span>Instructions</span>
				if agent.Name == "" && len(starters) > 0 {
					<span class="starters">Start from:
						for _, starter := range starters {
							<a href={ templ.URL("/configure/agents/new?start=" + starter.Name) }>{ starter.Label }</a>
						}
					</span>
				}
				<textarea name="prompt" required maxlength="16000" rows="16" placeholder="Describe what this agent reviews and what counts as a finding.">{ agent.Prompt }</textarea>
				<small>
					if agent.PromptRevision > 0 {
						Version { fmt.Sprint(agent.PromptRevision) }. Saving changed instructions creates version { fmt.Sprint(agent.PromptRevision + 1) }.
					}
					overload adds its own rules around these instructions: repository text is untrusted, and replies must be JSON findings. Do not put secrets here.
				</small>
			</label>
			<label class="check"><input type="checkbox" name="enabled" value="true" checked?={ agent.Enabled }/> Allow this agent in future runs</label><p class="muted">Turn off to pause this agent without deleting its setup. Workflows using a disabled agent cannot start new runs; already queued runs keep their saved configuration.</p>
			<div class="actions"><button type="submit">Save agent</button><a class="button secondary" href="/configure/agents">Cancel</a></div>
		</form></section>
		if agent.Name != "" {
			<section class="panel"><h2>Remove agent</h2><p class="muted">Agents used in workflows cannot be deleted. Disable this agent instead if it is still in use.</p><form method="post" action={ templ.URL("/configure/agents/" + agent.Name + "/delete") }><input type="hidden" name="csrf" value={ nonce }/><button class="danger" type="submit">Delete agent</button></form></section>
		}
	}
}

templ Repositories(repos []overload.Repository) {
	@layouts.Base(layouts.PageData{Title: "Repositories", CurrentPath: "/configure/repositories"}) {
		<div class="page-header"><div><p class="eyebrow">Automation / Repositories</p><h1>Repositories</h1><p class="muted">Manage each repository independently. Processing requires an enabled repository and a matching PR event binding.</p></div><a class="button" href="/configure/repositories/new">New repository</a></div>
		<section class="panel">
			if len(repos) == 0 {
				<div class="empty">No repositories yet. <a href="/configure/repositories/new">Add a repository</a> to configure PR events.</div>
			} else {
				<div class="table-wrap"><table><thead><tr><th>Repository</th><th>Access</th><th>Status</th><th>Mode</th><th></th></tr></thead><tbody>
					for _, repo := range repos {
						<tr><td><strong>{ repo.FullName }</strong></td><td>{ repositoryAccess(repo.InstallationID) }</td><td><span class="badge neutral">{ agentStatus(repo.Enabled) }</span></td><td>{ repositoryMode(repo.DryRun) }</td><td><a href={ templ.URL(fmt.Sprintf("/configure/repositories/%d", repo.ID)) }>View / edit</a></td></tr>
					}
				</tbody></table></div>
			}
		</section>
	}
}

templ RepositoryForm(repo overload.Repository, bindings []overload.TriggerBinding, workflows []overload.Workflow, nonce string) {
	@layouts.Base(layouts.PageData{Title: "Repository", CurrentPath: "/configure/repositories"}) {
		<div class="page-header"><div><p class="eyebrow"><a href="/configure">Configure</a> / <a href="/configure/repositories">Repositories</a></p><h1>{ repositoryFormTitle(repo) }</h1><p class="muted">Reviews stay dry-run unless posting is enabled here and the server runs with OVERLOAD_ENABLE_POSTING=1. Posting needs the GitHub App.</p></div><a href="/configure/repositories">All repositories</a></div>
		<section class="panel"><h2>Repository settings</h2><form method="post" action="/configure/repositories"><input type="hidden" name="csrf" value={ nonce }/>
			if repo.ID != 0 {
				<input type="hidden" name="id" value={ fmt.Sprint(repo.ID) }/>
			}
			<label class="field"><span>GitHub owner/repo</span><input name="name" required placeholder="owner/repo" value={ repo.FullName } readonly?={ repo.ID != 0 }/></label>
			<label class="check"><input type="checkbox" name="enabled" value="true" checked?={ repo.Enabled }/> Enable processing for this repository</label>
			<label class="check"><input type="checkbox" name="post" value="true" checked?={ repo.ID != 0 && !repo.DryRun }/> Post reviews as GitHub comments</label>
			<div class="actions"><button type="submit">Save repository</button><a class="button secondary" href="/configure/repositories">Cancel</a></div>
		</form></section>
		if repo.ID != 0 {
			<section class="panel"><div class="panel-head"><div><h2>PR event bindings</h2><p class="muted">Choose which PR actions run a workflow for this repository.</p></div></div>
				if len(repositoryBindings(bindings, repo.FullName)) == 0 {
					<div class="empty">No PR actions configured. Incoming events will be skipped.</div>
				}
				for _, binding := range repositoryBindings(bindings, repo.FullName) {
					<article class="profile"><div class="profile-top"><h3>{ binding.Action } → { binding.Workflow }</h3><span class="badge neutral">{ agentStatus(binding.Enabled) }</span></div>
						<form method="post" action="/configure/bindings"><input type="hidden" name="csrf" value={ nonce }/><input type="hidden" name="repository" value={ repo.FullName }/><input type="hidden" name="action" value={ binding.Action }/><input type="hidden" name="workflow" value={ binding.Workflow }/><input type="hidden" name="enabled" value={ fmt.Sprint(!binding.Enabled) }/><button class="secondary" type="submit">{ bindingAction(binding.Enabled) }</button></form>
						<form method="post" action={ templ.URL(fmt.Sprintf("/configure/repositories/%d/bindings/%d/delete", repo.ID, binding.ID)) }><input type="hidden" name="csrf" value={ nonce }/><button class="danger" type="submit">Delete binding</button></form>
					</article>
				}
				<form method="post" action="/configure/bindings"><input type="hidden" name="csrf" value={ nonce }/><input type="hidden" name="repository" value={ repo.FullName }/><input type="hidden" name="enabled" value="true"/><label class="field"><span>PR action</span><select name="action"><option value="opened">Opened</option><option value="synchronize">Updated</option><option value="reopened">Reopened</option><option value="ready_for_review">Ready for review</option></select></label><label class="field"><span>Workflow</span><select name="workflow" required><option value="">Select a PR workflow</option>
					for _, workflow := range workflows {
						if workflow.Kind == "pr_review" && workflow.Enabled {
							<option value={ workflow.Name }>{ workflow.Name }</option>
						}
					}
				</select></label><button type="submit">Add or update binding</button></form>
			</section>
			<section class="panel"><h2>Remove repository</h2><p class="muted">Repositories with bindings or runs cannot be deleted. Disable processing to keep their history.</p><form method="post" action={ templ.URL(fmt.Sprintf("/configure/repositories/%d/delete", repo.ID)) }><input type="hidden" name="csrf" value={ nonce }/><button class="danger" type="submit">Delete repository</button></form></section>
		}
	}
}

func repositoryAccess(installationID int64) string {
	if installationID > 0 {
		return "GitHub App"
	}
	return "Token (manual)"
}

func repositoryMode(dryRun bool) string {
	if dryRun {
		return "Dry run"
	}
	return "Posting opted in"
}
