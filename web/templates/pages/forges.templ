package pages

import (
	"github.com/daltoniam/overload"
	"github.com/daltoniam/overload/web/templates/layouts"
	"strconv"
)

type ForgeRow struct {
	ID           int64
	Name         string
	Kind         string
	BaseURL      string
	WebhookURL   string
	Repositories []overload.Repository
}

type ForgeSetupData struct {
	Connections []ForgeRow
	PublicBase  bool
	Name        string
	Kind        string
	BaseURL     string
	Error       string
	Notice      string
	CSRF        string
}

func forgeKindLabel(kind string) string {
	switch kind {
	case overload.ForgeGitLab:
		return "GitLab"
	case overload.ForgeForgejo:
		return "Forgejo / Gitea"
	}
	return kind
}

templ ForgeSetup(data ForgeSetupData) {
	@layouts.Base(layouts.PageData{Title: "Git hosts", CurrentPath: "/setup/forges"}) {
		<div class="page-header"><div><p class="eyebrow">Setup</p><h1>Git hosts</h1><p class="muted">Review merge requests on GitLab and pull requests on Forgejo or Gitea, self-hosted or not. GitHub connects through the <a href="/setup/github">GitHub App</a>.</p></div></div>
		if data.Error != "" {
			<p class="notice error" role="alert">{ data.Error }</p>
		}
		if data.Notice != "" {
			<p class="notice" role="status">{ data.Notice }</p>
		}
		if !data.PublicBase {
			<p class="notice error" role="status">Webhooks need overload's public https address. Set <code>OVERLOAD_BASE_URL</code> (or set up a <a href="/setup/tunnel">Cloudflare Tunnel</a>) before adding webhooks.</p>
		}
		for _, connection := range data.Connections {
			<section class="panel"><div class="panel-head"><div><h2>{ connection.Name }</h2><p class="muted">{ forgeKindLabel(connection.Kind) } at <a href={ templ.URL(connection.BaseURL) } rel="noopener">{ connection.BaseURL }</a></p></div></div>
				<dl>
					<dt>Webhook URL</dt><dd><code>{ connection.WebhookURL }</code></dd>
					<dt>Webhook secret</dt><dd>Generated by overload and kept in Postgres. Print it with <code>overload forges secret { connection.Name }</code> to add a webhook by hand.</dd>
				</dl>
				if len(connection.Repositories) == 0 {
					<div class="empty">No repositories on this host yet. <a href="/configure/repositories/new">Add a repository</a> and choose { connection.Name }.</div>
				} else {
					<div class="table-wrap"><table><thead><tr><th>Repository</th><th>Status</th><th>Webhook</th></tr></thead><tbody>
						for _, repo := range connection.Repositories {
							<tr><td><a href={ templ.URL("/configure/repositories/" + strconv.FormatInt(repo.ID, 10)) }>{ repo.FullName }</a></td><td><span class="badge neutral">{ agentStatus(repo.Enabled) }</span></td><td><form method="post" action={ templ.URL("/configure/repositories/" + strconv.FormatInt(repo.ID, 10) + "/webhook") }><input type="hidden" name="csrf" value={ data.CSRF }/><button class="secondary" type="submit" disabled?={ !data.PublicBase }>Create or update webhook</button></form></td></tr>
						}
					</tbody></table></div>
				}
				<details><summary>Change token or address</summary>
					<form method="post" action="/setup/forges"><input type="hidden" name="csrf" value={ data.CSRF }/><input type="hidden" name="name" value={ connection.Name }/><input type="hidden" name="kind" value={ connection.Kind }/>
						<label class="field"><span>Base URL</span><input name="base_url" type="url" required value={ connection.BaseURL }/></label>
						<label class="field"><span>New access token</span><input name="token" type="password" autocomplete="off" placeholder="leave empty to keep the current token"/></label>
						<button class="secondary" type="submit">Save</button>
					</form>
				</details>
				<form method="post" action={ templ.URL("/setup/forges/" + strconv.FormatInt(connection.ID, 10) + "/delete") }><input type="hidden" name="csrf" value={ data.CSRF }/>
					<label class="check"><input type="checkbox" required/> Remove { connection.Name } (only possible once it has no repositories or runs)</label>
					<button class="danger" type="submit">Remove git host</button>
				</form>
			</section>
		}
		<section class="panel"><h2>Add a git host</h2>
			<form method="post" action="/setup/forges"><input type="hidden" name="csrf" value={ data.CSRF }/>
				<label class="field"><span>Name</span><input name="name" required maxlength="64" pattern="[a-zA-Z0-9][a-zA-Z0-9_\-]*" placeholder="gitlab" value={ data.Name }/></label>
				<label class="field"><span>Kind</span><select name="kind" required>
					<option value="gitlab" selected?={ data.Kind == "gitlab" || data.Kind == "" }>GitLab</option>
					<option value="forgejo" selected?={ data.Kind == "forgejo" }>Forgejo / Gitea</option>
				</select></label>
				<label class="field"><span>Base URL</span><input name="base_url" type="url" required placeholder="https://gitlab.com" value={ data.BaseURL }/><small>The server's web address, for example https://gitlab.com, https://codeberg.org or your own server.</small></label>
				<label class="field"><span>Access token</span><input name="token" type="password" required autocomplete="off"/><small>GitLab: a project, group or personal access token with the <code>api</code> scope and at least the Developer role (Maintainer to create webhooks). Forgejo / Gitea: an access token with read and write access to repositories and issues (repository admin to create webhooks and withdraw requests for changes). Overload checks it before saving and keeps it in Postgres.</small></label>
				<button type="submit">Add git host</button>
			</form>
			<p class="muted">Pull requests on a new host use the same catch-all workflow bindings as GitHub until you change them on a repository's page.</p>
		</section>
	}
}
