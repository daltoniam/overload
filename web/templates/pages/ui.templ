package pages

import (
	"fmt"
	"github.com/daltoniam/overload"
	"github.com/daltoniam/overload/postgres"
	"strings"
)

templ SearchToolbar(path string, kinds []string, statuses []string) {
	<form class="search-toolbar" method="get" action={ templ.URL(path) } hx-get={ path } hx-target="#list-results" hx-swap="innerHTML swap:80ms settle:120ms" hx-trigger="submit, input delay:250ms, change" hx-sync="this:replace" hx-replace-url="true">
		<label class="search-field">Search<input type="search" name="q" value={ uiState(ctx).Query } placeholder="Search names, IDs or details" maxlength="200" autocomplete="off"/></label>
		if len(kinds) > 0 {
			<label>Type<select name="kind"><option value="">All types</option>
				for _, kind := range kinds {
					<option value={ kind } selected?={ uiState(ctx).Kind == kind }>{ filterLabel(kind) }</option>
				}
			</select></label>
		}
		if len(statuses) > 0 {
			<label>Status<select name="status"><option value="">All statuses</option>
				for _, status := range statuses {
					<option value={ status } selected?={ uiState(ctx).Status == status }>{ status }</option>
				}
			</select></label>
		}
		<button type="submit" class="secondary">Search</button><a href={ templ.URL(path) }>Clear</a><span class="htmx-indicator" role="status">Updating…</span>
	</form>
}

templ ResultsFooter(path string) {
	if uiState(ctx).Paginated {
		<div class="result-footer"><span role="status">{ fmt.Sprintf("%d matching records · page %d", uiState(ctx).Total, uiState(ctx).Page) }</span><div class="pagination">
			if uiState(ctx).Page > 1 {
				<a class="button secondary" href={ templ.URL(pageURL(ctx, path, uiState(ctx).Page-1)) } hx-get={ pageURL(ctx, path, uiState(ctx).Page-1) } hx-target="#list-results" hx-swap="innerHTML" hx-replace-url="true">Previous</a>
			}
			if uiState(ctx).Page*25 < uiState(ctx).Total {
				<a class="button secondary" href={ templ.URL(pageURL(ctx, path, uiState(ctx).Page+1)) } hx-get={ pageURL(ctx, path, uiState(ctx).Page+1) } hx-target="#list-results" hx-swap="innerHTML" hx-replace-url="true">Next</a>
			}
		</div></div>
	}
}

templ RunEvents(run overload.Run, events []postgres.RunEvent) {
	<div data-run-active={ fmt.Sprint(run.Status == overload.RunQueued || run.Status == overload.RunRunning) }>
		<div class="table-wrap"><table class="log-table wrap"><thead><tr><th>Timestamp</th><th>Level</th><th>Step</th><th>Message</th></tr></thead><tbody>
			for _, event := range events {
				if matches(ctx, "", "", event.Step, event.Message, event.Level) {
					<tr><td class="mono">{ event.At.Format("Jan 2 · 15:04:05") }</td><td>{ event.Level }</td><td>{ event.Step }</td><td class="message">{ event.Message }</td></tr>
				}
			}
		</tbody></table></div>
		<p class="result-footer">{ fmt.Sprintf("%d recorded events", len(events)) }</p>
	</div>
}

// WorkflowAgents edits a workflow's agent tree: one main agent and up to
// MaxSubAgents sub-agents. PR review workflows also choose each sub-agent's
// scope, the planner and verifier prompts and the routing limits.
templ WorkflowAgents(workflow overload.Workflow, agents []overload.AgentDefinition) {
	<fieldset class="tree-node main-agent"><legend>Main agent</legend>
		<label class="field"><span>Agent</span><select name="main_agent" required>
			<option value="">Select an agent</option>
			@agentOptions(workflow, agents, mainAgent(workflow))
		</select><small>Leads the review. It reviews files no sub-agent claimed (or every file), and runs the planner and verifier on its model.</small></label>
		if isPRWorkflow(workflow) {
			<label class="field"><span>Main agent reviews</span><select name="main_reviews">
				<option value="all" selected?={ workflow.MainReviews == "" || workflow.MainReviews == overload.MainReviewsAll }>Every changed file</option>
				<option value="unclaimed" selected?={ workflow.MainReviews == overload.MainReviewsUnclaimed }>Only files no sub-agent claimed</option>
			</select></label>
			<details class="scope" open?={ workflow.PlannerPrompt != "" }><summary>Planner { onOff(workflow.PlannerPrompt) }</summary>
				<label class="field"><span>Planner instructions</span><textarea name="planner_prompt" rows="5" class="short" maxlength="16000" placeholder="Send files that touch the database to the sub-agent whose description covers database access, whatever their path. Only assign files clearly in a sub-agent's area.">{ workflow.PlannerPrompt }</textarea><small>One model call per review that may give sub-agents extra files whatever they are named. It sees each sub-agent's description. Leave empty for no planner.</small></label>
			</details>
			<details class="scope" open?={ workflow.VerifierPrompt != "" }><summary>Verifier { onOff(workflow.VerifierPrompt) }</summary>
				<label class="field"><span>Verifier instructions</span><textarea name="verifier_prompt" rows="5" class="short" maxlength="16000" placeholder="Drop findings that are style preferences or speculation not shown by the changed lines. Keep real bugs.">{ workflow.VerifierPrompt }</textarea><small>One model call per sub-agent finding that keeps or drops it. Dropped findings stay on the run but are not posted. Leave empty for no verifier.</small></label>
			</details>
		}
	</fieldset>
	<fieldset class="tree-node"><legend>Sub-agents</legend>
		<p class="muted">Up to { fmt.Sprint(overload.MaxSubAgents) } sub-agents. Each reviews only the files it is for. Leave a slot empty to skip it.</p>
		<div class="sub-agents">
			for slot := 0; slot < overload.MaxSubAgents; slot++ {
				@subAgentSlot(workflow, agents, slot)
			}
		</div>
		<button type="button" class="secondary" data-add-sub-agent hidden>Add sub-agent</button>
	</fieldset>
	if isPRWorkflow(workflow) {
		<fieldset class="tree-node"><legend>Routing</legend>
			<label class="field"><span>Skip paths</span><textarea name="skip_paths" rows="3" class="short" placeholder="*.lock&#10;vendor/**&#10;**/*_templ.go">{ strings.Join(workflow.SkipPaths, "\n") }</textarea><small>One glob per line. Matching files are not reviewed by any agent. * stays in one folder, ** crosses folders, and a pattern without / matches the file name anywhere.</small></label>
			<label class="field"><span>File review limit</span><input type="number" name="max_file_reviews" min="0" max="10000" value={ optionalNumber(workflow.MaxFileReviews) } placeholder="No limit"/><small>Most (agent, file) reviews per run. A review needing more fails before calling a model; planner additions are dropped first.</small></label>
		</fieldset>
	}
}

templ agentOptions(workflow overload.Workflow, agents []overload.AgentDefinition, selected string) {
	for _, agent := range agents {
		if agent.Enabled && (agent.Kind == workflow.Kind || workflow.Kind == "" && agent.Kind == "pr_review") || inWorkflow(workflow, agent.Name) {
			<option value={ agent.Name } selected?={ selected == agent.Name }>{ agent.Name } · { agent.Model }</option>
		}
	}
}

templ subAgentSlot(workflow overload.Workflow, agents []overload.AgentDefinition, slot int) {
	<div class="workflow-slot sub-agent" data-slot={ fmt.Sprint(slot) } data-extra?={ slot > subAgentCount(workflow) }>
		<div class="slot-head">
			<label class="field"><span>Sub-agent { fmt.Sprint(slot+1) }</span><select name={ slotField(slot, "agent") }>
				<option value="">None</option>
				@agentOptions(workflow, agents, subAgent(workflow, slot))
			</select></label>
			if slot > 0 {
				<button type="button" class="secondary" data-move="up" aria-label={ fmt.Sprintf("Move sub-agent %d up", slot+1) }>↑</button>
			}
			if slot < overload.MaxSubAgents-1 {
				<button type="button" class="secondary" data-move="down" aria-label={ fmt.Sprintf("Move sub-agent %d down", slot+1) }>↓</button>
			}
		</div>
		if isPRWorkflow(workflow) {
			<div class="scope-chips" aria-label="Scope">
				for _, chip := range scopeChips(subScope(workflow, slot)) {
					<span class="chip">{ chip }</span>
				}
			</div>
			<details class="scope" open?={ subAgent(workflow, slot) != "" && len(scopeChips(subScope(workflow, slot))) == 0 }><summary>Scope</summary>
				<label class="field"><span>Files</span><select name={ slotField(slot, "mode") }>
					<option value="globs" selected?={ subScope(workflow, slot).Mode == "" || subScope(workflow, slot).Mode == overload.ScopeGlobs }>Matching paths, plus files the planner adds</option>
					<option value="always" selected?={ subScope(workflow, slot).Mode == overload.ScopeAlways }>Only matching paths</option>
					<option value="planned" selected?={ subScope(workflow, slot).Mode == overload.ScopePlanned }>Only files the planner assigns</option>
				</select></label>
				<label class="field"><span>Paths</span><textarea name={ slotField(slot, "paths") } rows="3" class="short" placeholder="**/auth/**&#10;**/*.sql">{ strings.Join(subScope(workflow, slot).Paths, "\n") }</textarea><small>One glob per line. No paths means every changed file (except with "Only files the planner assigns").</small></label>
				<label class="field"><span>Description for the planner</span><input name={ slotField(slot, "description") } maxlength="300" value={ subScope(workflow, slot).Description } placeholder="Authentication, sessions and access control"/></label>
				<label class="field"><span>Most findings</span><input type="number" name={ slotField(slot, "max_findings") } min="0" max="50" value={ optionalNumber(subScope(workflow, slot).MaxFindings) } placeholder="No limit"/><small>Keeps the most severe, most confident findings.</small></label>
			</details>
		}
	</div>
}

templ ValidationError(message string) {
	<p class="notice error">{ message }</p>
}

templ Confirmation(action string, nonce string, values map[string][]string) {
	<div class="page-header"><div><p class="eyebrow">Confirm removal</p><h1>Delete this resource?</h1><p class="muted">This cannot be undone. Resources with dependent configuration or history cannot be removed.</p></div></div>
	<section class="panel danger-zone"><form method="post" action={ templ.URL(action) }>
		<input type="hidden" name="csrf" value={ nonce }/><input type="hidden" name="confirmed" value="true"/>
		for name, entries := range values {
			if name != "csrf" && name != "confirmed" {
				for _, value := range entries {
					<input type="hidden" name={ name } value={ value }/>
				}
			}
		}
		<div class="actions"><a class="button secondary" href="/">Cancel</a><button class="danger" type="submit">Confirm deletion</button></div>
	</form></section>
}
