# Reference for running overload by hand. `overload install` writes its own
# config file; every variable here can also be set in the environment.

# Required
DATABASE_URL=postgres://overload:overload@localhost:5432/overload?sslmode=disable
OVERLOAD_UI_USER=admin
OVERLOAD_UI_PASSWORD=

# UI address. Set OVERLOAD_BASE_URL to the URL you open in the browser if it
# is not 127.0.0.1 or localhost; other hosts are rejected.
OVERLOAD_ADDR=127.0.0.1:8082
OVERLOAD_BASE_URL=http://127.0.0.1:8082

# Default model for `overload review` when no saved model exists.
OVERLOAD_DEFAULT_MODEL_BASE_URL=http://127.0.0.1:8000/v1
OVERLOAD_DEFAULT_MODEL=
OVERLOAD_DEFAULT_MODEL_API_KEY=

# GitHub: a token for repositories added by hand, or a GitHub App (normally
# created from the UI at /setup/github instead).
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Post reviews to GitHub (also needs the repository's posting toggle).
OVERLOAD_ENABLE_POSTING=0

# Kubernetes only: run webhook reviews in Agent Sandbox pods.
OVERLOAD_SANDBOX=host
OVERLOAD_SANDBOX_NAMESPACE=overload
OVERLOAD_SANDBOX_WARMPOOL=overload-agent
OVERLOAD_SANDBOX_CONNECTIVITY=in-cluster-service
